{
	"name": "htmx-tags",
	"displayName": "HTMX Tags",
	"description": "Provides HTMX tag completion in HTML files in VSCode",
	"version": "1.0.0",
	"publisher": "otovo-oss",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/otovo/htmx-tags"
	},
	"homepage": "https://github.com/otovo/htmx-tags",
	"bugs": {
		"url": "https://github.com/otovo/htmx-tags/issues"
	},
	"keywords": [
		"htmx",
		"html",
		"django",
		"completion",
		"intellisense",
		"autocomplete",
		"hypermedia",
		"attributes"
	],
	"categories": [
		"Programming Languages"
	],
	"engines": {
		"vscode": "^1.74.0"
	},
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#3D72D7",
		"theme": "dark"
	},
	"extensionKind": [
		"workspace",
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && node esbuild.js",
		"compile-tests": "tsc -p . --outDir out",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && node esbuild.js --production",
		"check-types": "tsc --noEmit",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"activationEvents": [
		"onLanguage:django-html",
		"onLanguage:html",
		"onLanguage:htmx"
	],
	"contributes": {
		"languages": [
			{
				"id": "htmx",
				"aliases": [
					"HTMX",
					"htmx"
				],
				"extensions": [
					".htmx"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"html": {
			"customData": [
				"./html.htmx-data.json"
			]
		}
	},
	"devDependencies": {
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.1",
		"@types/node": "20.2.5",
		"@types/vscode": "^1.74.0",
		"@typescript-eslint/eslint-plugin": "^5.59.8",
		"@typescript-eslint/parser": "^5.59.8",
		"@vscode/test-electron": "^2.3.2",
		"esbuild": "^0.19.0",
		"eslint": "^8.41.0",
		"glob": "^8.1.0",
		"mocha": "^10.2.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.1.3"
	}
}
